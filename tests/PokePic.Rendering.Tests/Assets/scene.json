{
  // Covers every element type with opaque colors only, so pixel-perfect output must have binary alpha.
  "id": "scene",
  "canvas": { "width": 64, "height": 48, "mode": "pixelPerfect", "scale": 1 },
  "values": {
    "image": { "types": { "pattern": "{key}.png" } },
    "font": { "pixel": "pixel.ttf" }
  },
  "elements": [
    { "type": "shape", "rect": [0, 0, 64, 48], "radius": 6, "fill": { "linear": { "from": [0, 0], "to": [64, 0], "stops": [[0, "{color1}"], [1, "#3050C0"]] } } },
    { "type": "shape", "rect": [2, 2, 28, 20], "radius": 4, "fill": "#FFFFFF", "stroke": { "color": "#000000", "width": 1 } },
    { "type": "shape", "shape": "ellipse", "rect": [34, 4, 12, 12], "fill": "#FFD000" },
    { "type": "line", "from": [2, 25], "to": [61, 25], "color": "#000000" },
    { "type": "line", "from": [2, 27], "to": [20, 45], "color": "#FFFFFF", "width": 2 },
    { "type": "image", "rect": [50, 5, 10, 10], "image": { "set": "types", "key": "{type}" } },
    { "type": "image", "rect": [30, 26, 34, 28], "image": "{sprite}", "fit": "contain", "anchor": "bottomRight", "flip": "horizontal" },
    { "type": "text", "rect": [4, 4, 24, 16], "text": "Lv.{level}", "font": "{pixel}", "size": 8, "color": "#000000", "align": "center", "valign": "middle" },
    { "type": "shape", "rect": [0, 0, 64, 48], "fill": "#FF00FF", "visible": "{!hasType2}" }
  ]
}
