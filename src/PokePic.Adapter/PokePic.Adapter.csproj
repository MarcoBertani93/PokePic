<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PokePic.Adapter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- At run time PKHeX.Core is PKHeX's own: the plugin does not ship it. -->
    <PackageReference Include="PKHeX.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Names of the PokeAPI images of every form: generated by build/generate-pokeapi.cs. -->
    <EmbeddedResource Include="PokeApi.json" LogicalName="PokePic.Adapter.PokeApi.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokePic.Core\PokePic.Core.csproj" />
  </ItemGroup>

</Project>
