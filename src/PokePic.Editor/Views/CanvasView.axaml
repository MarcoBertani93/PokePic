<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:PokePic.Editor.ViewModels.Docking"
             xmlns:views="using:PokePic.Editor.Views"
             xmlns:loc="using:PokePic.Editor.Localization"
             x:Class="PokePic.Editor.Views.CanvasView"
             x:DataType="dock:CanvasDocument">
  <UserControl.Styles>
    <Style Selector="Path.barIcon">
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.barText">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
    </Style>
    <Style Selector="Button.bar, ToggleButton.bar, DropDownButton.bar">
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bar, DropDownButton.bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Bottom bar, as in Paint.NET: canvas size, cursor position, zoom. -->
    <Border DockPanel.Dock="Bottom" Padding="8,2" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Path Classes="barIcon" Data="M1.5,3.5 H14.5 V12.5 H1.5 Z M4,6 L7,6 M4,6 L4,9 M12,10 L9,10 M12,10 L12,7" ToolTip.Tip="{loc:Loc CanvasSize}" />
        <TextBlock Classes="barText" Text="{Binding Main.CanvasSizeText}" MinWidth="76" ToolTip.Tip="{loc:Loc CanvasSize}" />
        <Path Classes="barIcon" Data="M4,1.5 L4,12.5 L6.8,10 L8.7,14.5 L10.5,13.7 L8.6,9.3 L12,9.3 Z" ToolTip.Tip="{loc:Loc CursorPosition}" />
        <TextBlock Classes="barText" Text="{Binding Main.CursorPosition}" MinWidth="64" ToolTip.Tip="{loc:Loc CursorPosition}" />
        <TextBlock Classes="barText" Text="px" Opacity="0.7" Margin="0,0,4,0" />
        <DropDownButton x:Name="ZoomButton" Classes="bar" Content="{Binding Main.ZoomText}" MinWidth="64" ToolTip.Tip="{loc:Loc Zoom}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <ToggleButton Classes="bar" IsChecked="{Binding Main.IsFitToWindow, Mode=OneWay}" Command="{Binding Main.ToggleFitCommand}"
                      ToolTip.Tip="{loc:Loc ZoomFitToggle}">
          <Path Classes="barIcon" Data="M1.5,5.5 V1.5 H5.5 M10.5,1.5 H14.5 V5.5 M14.5,10.5 V14.5 H10.5 M5.5,14.5 H1.5 V10.5 M5,5 H11 V11 H5 Z" />
        </ToggleButton>
        <Button Classes="bar" Command="{Binding Main.ZoomOutCommand}" ToolTip.Tip="{loc:Loc ZoomOut}">
          <Path Classes="barIcon" Data="M6.5,2 A4.5,4.5 0 1 1 6.49,2 Z M10,10 L14.5,14.5 M4.5,6.5 H8.5" />
        </Button>
        <Slider Width="130" VerticalAlignment="Center" Margin="0,-6"
                Minimum="{x:Static views:CanvasView.ZoomSliderMinimum}" Maximum="{x:Static views:CanvasView.ZoomSliderMaximum}"
                Value="{Binding Main.ZoomSlider, Mode=TwoWay}" ToolTip.Tip="{loc:Loc Zoom}" />
        <Button Classes="bar" Command="{Binding Main.ZoomInCommand}" ToolTip.Tip="{loc:Loc ZoomIn}">
          <Path Classes="barIcon" Data="M6.5,2 A4.5,4.5 0 1 1 6.49,2 Z M10,10 L14.5,14.5 M4.5,6.5 H8.5 M6.5,4.5 V8.5" />
        </Button>
      </StackPanel>
    </Border>

    <Grid Background="#4A4A4A" ClipToBounds="True" PointerPressed="OnBackgroundPressed">
      <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Border Margin="{x:Static views:CanvasView.CardMarginThickness}" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 2 12 0 #80000000">
          <views:CardCanvas x:Name="Canvas"
                            Source="{Binding Main.Preview}"
                            Zoom="{Binding Main.Zoom}"
                            RenderScale="{Binding Main.RenderedScale}"
                            Selection="{Binding Main.SelectionBounds}"
                            Handles="{Binding Main.SelectionHandles}"
                            Parts="{Binding Main.SelectionParts}" />
        </Border>
      </ScrollViewer>
      <Border IsVisible="{Binding Main.PreviewOutdated}" VerticalAlignment="Top" Background="#D0A03020" Padding="8,4">
        <TextBlock Text="{loc:Loc PreviewOutdated}" Foreground="White" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
