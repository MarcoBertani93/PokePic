<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokePic.Editor.ViewModels"
             xmlns:dock="using:PokePic.Editor.ViewModels.Docking"
             xmlns:loc="using:PokePic.Editor.Localization"
             x:Class="PokePic.Editor.Views.ProblemsView"
             x:DataType="dock:ProblemsTool">
  <Grid>
    <TextBlock Text="{loc:Loc NoIssues}" IsVisible="{Binding !Main.HasIssues}" Margin="8" Opacity="0.7" />
    <ListBox x:Name="IssuesList" ItemsSource="{Binding Main.Issues}" IsVisible="{Binding Main.HasIssues}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:IssueItem">
          <StackPanel>
            <TextBlock Text="{Binding Location}" FontSize="11" Opacity="0.7" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
