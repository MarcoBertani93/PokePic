<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared by the resource panels (variables, localized texts, fonts, images, image sets, styles). -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.info">
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#E05050" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.tool">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinWidth" Value="28" />
  </Style>
  <Style Selector="Border.item">
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>
</Styles>
