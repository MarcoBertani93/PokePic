            { "name": "Icon", "type": "image", "rect": [1, 1, 10, 10], "image": { "set": "types", "key": "{move2.type.key}" } }
          ]
        },
        { "name": "Move 2", "type": "text", "style": "value", "rect": [150, 138, 76, 10], "text": "{move2.name}", "visible": "{hasMove2}" },
        { "name": "Move 2 PP", "type": "text", "style": "value", "rect": [224, 138, 23, 10], "text": "{move2.pp}", "align": "right", "visible": "{hasMove2}" },
        { "name": "Move 3 band", "type": "shape", "rect": [134, 153, 116, 15], "fill": "{move3.type.color}", "radius": 2, "visible": "{hasMove3}" },
        { "name": "Move 3 veil", "type": "shape", "rect": [134, 153, 116, 15], "fill": "#FFFFFFA0", "radius": 2, "visible": "{hasMove3}" },
        {
          "name": "Move 3 type",
          "type": "group",
          "position": [136, 154],
