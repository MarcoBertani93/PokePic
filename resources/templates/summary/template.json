        { "name": "DEF EV", "type": "text", "style": "value", "rect": [94, 146, 30, 10], "text": "{ev.def}", "align": "right" },
        { "name": "SP.A", "type": "text", "style": "label", "rect": [8, 156, 26, 10], "text": "SP.A" },
        { "name": "SP.A raised", "type": "text", "style": "label", "rect": [8, 156, 26, 10], "text": "SP.A", "color": "#E03030", "visible": "{nature.up.spa}" },
        { "name": "SP.A lowered", "type": "text", "style": "label", "rect": [8, 156, 26, 10], "text": "SP.A", "color": "#3060E0", "visible": "{nature.down.spa}" },
        { "name": "SP.A stat", "type": "text", "style": "value", "rect": [34, 156, 20, 10], "text": "{stat.spa}", "align": "right" },
        { "name": "SP.A track", "type": "shape", "rect": [58, 159, 33, 5], "fill": "{dark}" },
        { "name": "SP.A IV", "type": "shape", "rect": [59, 160, "{iv.spa}", 3], "fill": "{bar}" },
        { "name": "SP.A EV", "type": "text", "style": "value", "rect": [94, 156, 30, 10], "text": "{ev.spa}", "align": "right" },
        { "name": "SP.D", "type": "text", "style": "label", "rect": [8, 166, 26, 10], "text": "SP.D" },
        { "name": "SP.D raised", "type": "text", "style": "label", "rect": [8, 166, 26, 10], "text": "SP.D", "color": "#E03030", "visible": "{nature.up.spd}" },
        { "name": "SP.D lowered", "type": "text", "style": "label", "rect": [8, 166, 26, 10], "text": "SP.D", "color": "#3060E0", "visible": "{nature.down.spd}" },
        { "name": "SP.D stat", "type": "text", "style": "value", "rect": [34, 166, 20, 10], "text": "{stat.spd}", "align": "right" },
        { "name": "SP.D track", "type": "shape", "rect": [58, 169, 33, 5], "fill": "{dark}" },
        { "name": "SP.D IV", "type": "shape", "rect": [59, 170, "{iv.spd}", 3], "fill": "{bar}" },
        { "name": "SP.D EV", "type": "text", "style": "value", "rect": [94, 166, 30, 10], "text": "{ev.spd}", "align": "right" },
        { "name": "SPE", "type": "text", "style": "label", "rect": [8, 176, 26, 10], "text": "SPE" },
        { "name": "SPE raised", "type": "text", "style": "label", "rect": [8, 176, 26, 10], "text": "SPE", "color": "#E03030", "visible": "{nature.up.spe}" },
        { "name": "SPE lowered", "type": "text", "style": "label", "rect": [8, 176, 26, 10], "text": "SPE", "color": "#3060E0", "visible": "{nature.down.spe}" },
        { "name": "SPE stat", "type": "text", "style": "value", "rect": [34, 176, 20, 10], "text": "{stat.spe}", "align": "right" },
        { "name": "SPE track", "type": "shape", "rect": [58, 179, 33, 5], "fill": "{dark}" },
        { "name": "SPE IV", "type": "shape", "rect": [59, 180, "{iv.spe}", 3], "fill": "{bar}" },
        { "name": "SPE EV", "type": "text", "style": "value", "rect": [94, 176, 30, 10], "text": "{ev.spe}", "align": "right" }
      ]
    },
    {
      "name": "Moves",
      "type": "group",
      "position": [0, 0],
      "children": [
        { "name": "Frame", "type": "shape", "rect": [132, 116, 120, 72], "fill": "#FFFFFF", "stroke": { "color": "{dark}", "width": 1 }, "radius": 3 },
